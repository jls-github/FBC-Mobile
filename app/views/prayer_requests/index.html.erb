<div class="px-4 py-4">
  <h1 class="text-2xl font-bold text-gray-900 mb-1">Prayer</h1>
  <p class="text-gray-500 text-sm mb-5">We believe in the power of prayer. Let us pray with you.</p>

  <!-- Submit Form -->
  <div id="prayer-form">
    <%= render "prayer_requests/form", prayer_request: @new_request %>
  </div>

  <!-- Community Prayers -->
  <% if @public_requests.any? %>
    <div class="mt-8">
      <h2 class="font-bold text-gray-900 mb-3">Community Prayer Wall</h2>
      <div id="public-prayers" class="space-y-3">
        <% @public_requests.each do |pr| %>
          <%= render "prayer_requests/prayer_card", prayer_request: pr %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
