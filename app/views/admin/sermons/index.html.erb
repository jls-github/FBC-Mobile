<% content_for :page_title, "Sermons" %>
<div class="flex justify-between items-center mb-6">
  <p class="text-gray-500 text-sm"><%= @sermons.count %> total</p>
  <%= link_to "+ New Sermon", new_admin_sermon_path, class: "bg-church-navy text-white text-sm font-semibold px-4 py-2 rounded-lg" %>
</div>
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
      <tr>
        <th class="text-left px-4 py-3">Title</th>
        <th class="text-left px-4 py-3 hidden md:table-cell">Speaker</th>
        <th class="text-left px-4 py-3 hidden md:table-cell">Date</th>
        <th class="text-left px-4 py-3 hidden lg:table-cell">Series</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% @sermons.each do |sermon| %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3">
            <div class="font-medium text-gray-900"><%= sermon.title %></div>
            <% if sermon.featured? %><span class="text-xs text-church-gold font-semibold">Featured</span><% end %>
          </td>
          <td class="px-4 py-3 text-gray-500 hidden md:table-cell"><%= sermon.speaker %></td>
          <td class="px-4 py-3 text-gray-500 hidden md:table-cell"><%= sermon.preached_on&.strftime("%b %-d, %Y") %></td>
          <td class="px-4 py-3 text-gray-500 hidden lg:table-cell"><%= sermon.sermon_series&.name %></td>
          <td class="px-4 py-3 text-right">
            <%= link_to "Edit", edit_admin_sermon_path(sermon), class: "text-church-navy text-xs font-medium mr-3" %>
            <%= button_to "Delete", admin_sermon_path(sermon), method: :delete, data: { confirm: "Delete this sermon?" }, class: "text-red-500 text-xs font-medium" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
