<% content_for :page_title, "Prayer Requests" %>
<div class="flex gap-2 mb-6">
  <%= link_to "All", admin_prayer_requests_path, class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:status].blank? ? 'bg-church-navy text-white' : 'bg-white border border-gray-200 text-gray-600'}" %>
  <% %w[new praying answered].each do |s| %>
    <%= link_to s.humanize, admin_prayer_requests_path(status: s), class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:status] == s ? 'bg-church-navy text-white' : 'bg-white border border-gray-200 text-gray-600'}" %>
  <% end %>
</div>
<div class="space-y-3">
  <% @prayer_requests.each do |pr| %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1">
            <span class="font-semibold text-gray-900 text-sm"><%= pr.display_name %></span>
            <% if pr.email.present? %>
              <a href="mailto:<%= pr.email %>" class="text-xs text-church-navy"><%= pr.email %></a>
            <% end %>
            <span class="text-xs text-gray-400"><%= pr.created_at.strftime("%b %-d") %></span>
          </div>
          <p class="text-gray-600 text-sm"><%= pr.request %></p>
        </div>
        <div class="flex flex-col items-end gap-2 flex-shrink-0">
          <span class="text-xs px-2 py-0.5 rounded-full <%= pr.status == 'new' ? 'bg-red-100 text-red-700' : pr.status == 'praying' ? 'bg-blue-100 text-blue-700' : 'bg-green-100 text-green-700' %>">
            <%= pr.status.humanize %>
          </span>
          <div class="flex gap-2">
            <% %w[new praying answered].each do |s| %>
              <% unless pr.status == s %>
                <%= button_to s.humanize, admin_prayer_request_path(pr), method: :patch, params: { prayer_request: { status: s } }, class: "text-xs text-church-navy border border-church-navy/30 px-2 py-0.5 rounded" %>
              <% end %>
            <% end %>
            <%= button_to "Delete", admin_prayer_request_path(pr), method: :delete, data: { confirm: "Delete this prayer request?" }, class: "text-xs text-red-500" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
