<div class="px-4 py-4">
  <h1 class="text-2xl font-bold text-gray-900 mb-1">Sermons</h1>
  <p class="text-gray-500 text-sm mb-4">Messages from First Baptist Church of Enumclaw</p>

  <!-- Series Filter -->
  <% if @series_list.any? %>
    <div class="flex gap-2 overflow-x-auto pb-2 mb-4 -mx-4 px-4 scrollbar-hide">
      <%= link_to "All", sermons_path, class: "flex-shrink-0 px-4 py-1.5 rounded-full text-sm font-medium #{params[:series_id].blank? ? 'bg-church-navy text-white' : 'bg-white text-gray-600 border border-gray-200'}" %>
      <% @series_list.each do |series| %>
        <%= link_to series.name, sermons_path(series_id: series.id), class: "flex-shrink-0 px-4 py-1.5 rounded-full text-sm font-medium #{params[:series_id] == series.id.to_s ? 'bg-church-navy text-white' : 'bg-white text-gray-600 border border-gray-200'}" %>
      <% end %>
    </div>
  <% end %>

  <!-- Sermon List -->
  <div class="space-y-3">
    <% @sermons.each do |sermon| %>
      <%= link_to sermon_path(sermon), class: "flex gap-3 bg-white rounded-2xl p-4 shadow-sm border border-gray-100", data: { turbo_action: "advance" } do %>
        <div class="w-16 h-16 bg-church-navy rounded-xl flex items-center justify-center flex-shrink-0 relative overflow-hidden">
          <% if sermon.thumbnail_url.present? %>
            <img src="<%= sermon.thumbnail_url %>" alt="" class="w-full h-full object-cover">
          <% end %>
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-8 h-8 bg-church-gold rounded-full flex items-center justify-center">
              <svg class="w-4 h-4 text-church-navy ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="font-semibold text-gray-900 text-sm leading-tight line-clamp-2"><%= sermon.title %></h3>
          <p class="text-gray-500 text-xs mt-0.5"><%= sermon.speaker %></p>
          <div class="flex items-center gap-2 mt-1">
            <% if sermon.preached_on %>
              <span class="text-gray-400 text-xs"><%= sermon.preached_on.strftime("%B %-d, %Y") %></span>
            <% end %>
            <% if sermon.formatted_duration %>
              <span class="text-gray-300 text-xs">·</span>
              <span class="text-gray-400 text-xs"><%= sermon.formatted_duration %></span>
            <% end %>
          </div>
          <% if sermon.scripture_reference.present? %>
            <span class="inline-block mt-1 text-xs text-church-navy font-medium"><%= sermon.scripture_reference %></span>
          <% end %>
        </div>
        <svg class="w-4 h-4 text-gray-300 flex-shrink-0 mt-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
        </svg>
      <% end %>
    <% end %>
  </div>

  <!-- Pagination -->
  <% if @sermons.respond_to?(:total_pages) && @sermons.total_pages > 1 %>
    <div class="flex justify-center gap-2 mt-6">
      <% if @sermons.prev_page %>
        <%= link_to "← Previous", sermons_path(page: @sermons.prev_page, series_id: params[:series_id]), class: "px-4 py-2 bg-white border border-gray-200 rounded-lg text-sm text-gray-600" %>
      <% end %>
      <% if @sermons.next_page %>
        <%= link_to "Next →", sermons_path(page: @sermons.next_page, series_id: params[:series_id]), class: "px-4 py-2 bg-church-navy text-white rounded-lg text-sm" %>
      <% end %>
    </div>
  <% end %>
</div>
