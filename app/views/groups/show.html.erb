<div class="px-4 pt-4 pb-2">
  <%= link_to groups_path, class: "flex items-center gap-1 text-church-navy text-sm font-medium", data: { turbo_action: "advance" } do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/>
    </svg>
    Connect
  <% end %>
</div>

<div class="px-4 py-4">
  <div class="bg-church-navy rounded-2xl p-6 text-white mb-5">
    <div class="w-16 h-16 bg-church-gold/20 rounded-2xl flex items-center justify-center mb-3">
      <svg class="w-8 h-8 text-church-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/>
      </svg>
    </div>
    <h1 class="text-xl font-bold"><%= @group.name %></h1>
    <% if @group.open_enrollment? %>
      <span class="inline-block mt-1 bg-green-400/20 text-green-300 text-xs font-semibold px-2 py-0.5 rounded-full">Open Enrollment</span>
    <% end %>
  </div>

  <div class="space-y-3 mb-5">
    <% if @group.leader_name.present? %>
      <div class="flex items-center gap-3 bg-white rounded-xl p-3 border border-gray-100">
        <div class="w-9 h-9 bg-church-navy/5 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-church-navy" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
          </svg>
        </div>
        <div>
          <div class="text-xs text-gray-500">Group Leader</div>
          <div class="text-sm font-medium text-gray-900"><%= @group.leader_name %></div>
        </div>
      </div>
    <% end %>
    <% if @group.meeting_schedule.present? %>
      <div class="flex items-center gap-3 bg-white rounded-xl p-3 border border-gray-100">
        <div class="w-9 h-9 bg-church-navy/5 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-church-navy" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <div class="text-xs text-gray-500">Meeting Time</div>
          <div class="text-sm font-medium text-gray-900"><%= @group.meeting_schedule %></div>
        </div>
      </div>
    <% end %>
    <% if @group.location.present? %>
      <div class="flex items-center gap-3 bg-white rounded-xl p-3 border border-gray-100">
        <div class="w-9 h-9 bg-church-navy/5 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-church-navy" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
          </svg>
        </div>
        <div>
          <div class="text-xs text-gray-500">Location</div>
          <div class="text-sm font-medium text-gray-900"><%= @group.location %></div>
        </div>
      </div>
    <% end %>
  </div>

  <h2 class="font-semibold text-gray-900 mb-2">About This Group</h2>
  <p class="text-gray-600 text-sm leading-relaxed mb-6"><%= @group.description %></p>

  <% if @group.leader_email.present? %>
    <a href="mailto:<%= @group.leader_email %>?subject=Interest in <%= URI.encode_www_form_component(@group.name) %>" class="block w-full text-center bg-church-navy text-white font-bold py-3.5 rounded-2xl text-sm mb-2">
      Contact Group Leader
    </a>
  <% end %>
  <%= link_to contact_path, class: "block w-full text-center border border-gray-200 text-gray-600 font-medium py-3 rounded-2xl text-sm", data: { turbo_action: "advance" } do %>
    More Info
  <% end %>
</div>
