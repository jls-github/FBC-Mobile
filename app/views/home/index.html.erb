<!-- Hero / Featured Sermon -->
<% if @featured_sermon %>
  <section class="relative bg-church-navy overflow-hidden">
    <% if @featured_sermon.thumbnail_url.present? %>
      <img src="<%= @featured_sermon.thumbnail_url %>" alt="" class="absolute inset-0 w-full h-full object-cover opacity-30">
    <% else %>
      <div class="absolute inset-0 bg-gradient-to-br from-church-navy via-blue-900 to-church-gold opacity-80"></div>
    <% end %>
    <div class="relative px-4 py-8">
      <div class="inline-flex items-center gap-1.5 bg-church-gold/20 border border-church-gold/40 rounded-full px-3 py-1 mb-3">
        <div class="w-2 h-2 bg-church-gold rounded-full animate-pulse"></div>
        <span class="text-church-gold text-xs font-semibold uppercase tracking-wide">Latest Message</span>
      </div>
      <h1 class="text-white text-2xl font-bold leading-tight mb-1"><%= @featured_sermon.title %></h1>
      <p class="text-blue-200 text-sm mb-1"><%= @featured_sermon.speaker %></p>
      <% if @featured_sermon.scripture_reference.present? %>
        <p class="text-church-gold text-xs mb-4"><%= @featured_sermon.scripture_reference %></p>
      <% end %>
      <div class="flex gap-2">
        <%= link_to sermon_path(@featured_sermon), class: "flex items-center gap-2 bg-church-gold text-church-navy font-bold text-sm px-5 py-2.5 rounded-full", data: { turbo_action: "advance" } do %>
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          Watch Now
        <% end %>
        <%= link_to sermons_path, class: "flex items-center gap-1 text-white/80 text-sm px-4 py-2.5 rounded-full border border-white/20", data: { turbo_action: "advance" } do %>
          All Sermons
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- Announcements Carousel -->
<% if @announcements.any? %>
  <section class="mt-6 px-4" data-controller="carousel">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-gray-900 font-bold text-lg">Announcements</h2>
    </div>
    <div class="space-y-3">
      <% @announcements.each do |announcement| %>
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <% if announcement.image_url.present? %>
            <img src="<%= announcement.image_url %>" alt="<%= announcement.title %>" class="w-full h-36 object-cover">
          <% end %>
          <div class="p-4">
            <% if announcement.featured? %>
              <span class="text-xs font-semibold text-church-gold uppercase tracking-wide">Featured</span>
            <% end %>
            <h3 class="font-bold text-gray-900 mt-0.5"><%= announcement.title %></h3>
            <p class="text-gray-600 text-sm mt-1 line-clamp-2"><%= announcement.content %></p>
            <% if announcement.link_url.present? %>
              <a href="<%= announcement.link_url %>" class="inline-block mt-2 text-church-navy text-sm font-semibold">
                <%= announcement.link_label.presence || "Learn More" %> &rarr;
              </a>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<!-- Upcoming Events -->
<% if @upcoming_events.any? %>
  <section class="mt-6 px-4">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-gray-900 font-bold text-lg">Upcoming Events</h2>
      <%= link_to "See All", events_path, class: "text-church-navy text-sm font-semibold", data: { turbo_action: "advance" } %>
    </div>
    <div class="space-y-3">
      <% @upcoming_events.each do |event| %>
        <%= link_to event_path(event), class: "flex items-start gap-3 bg-white rounded-2xl p-4 shadow-sm border border-gray-100", data: { turbo_action: "advance" } do %>
          <div class="bg-church-navy rounded-xl p-2 text-center min-w-[52px]">
            <div class="text-church-gold text-xs font-bold uppercase"><%= event.starts_at.strftime("%b") %></div>
            <div class="text-white text-xl font-bold leading-tight"><%= event.starts_at.strftime("%-d") %></div>
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="font-semibold text-gray-900 text-sm leading-tight"><%= event.title %></h3>
            <p class="text-gray-500 text-xs mt-0.5"><%= event.formatted_time %></p>
            <p class="text-gray-500 text-xs"><%= event.location %></p>
          </div>
          <svg class="w-4 h-4 text-gray-300 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
          </svg>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>

<!-- Quick Actions -->
<section class="mt-6 px-4">
  <h2 class="text-gray-900 font-bold text-lg mb-3">Connect With Us</h2>
  <div class="grid grid-cols-2 gap-3">
    <%= link_to prayer_requests_path, class: "bg-church-navy rounded-2xl p-4 text-white", data: { turbo_action: "advance" } do %>
      <div class="w-10 h-10 bg-white/10 rounded-xl flex items-center justify-center mb-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/>
        </svg>
      </div>
      <div class="font-semibold text-sm">Prayer</div>
      <div class="text-white/60 text-xs">Submit a request</div>
    <% end %>

    <%= link_to give_path, class: "bg-church-gold rounded-2xl p-4 text-church-navy", data: { turbo_action: "advance" } do %>
      <div class="w-10 h-10 bg-church-navy/10 rounded-xl flex items-center justify-center mb-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
        </svg>
      </div>
      <div class="font-bold text-sm">Give Online</div>
      <div class="text-church-navy/60 text-xs">Support our ministry</div>
    <% end %>

    <%= link_to groups_path, class: "bg-white rounded-2xl p-4 border border-gray-100 shadow-sm", data: { turbo_action: "advance" } do %>
      <div class="w-10 h-10 bg-church-navy/5 rounded-xl flex items-center justify-center mb-2">
        <svg class="w-5 h-5 text-church-navy" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/>
        </svg>
      </div>
      <div class="font-semibold text-gray-900 text-sm">Small Groups</div>
      <div class="text-gray-400 text-xs">Find community</div>
    <% end %>

    <%= link_to about_path, class: "bg-white rounded-2xl p-4 border border-gray-100 shadow-sm", data: { turbo_action: "advance" } do %>
      <div class="w-10 h-10 bg-church-navy/5 rounded-xl flex items-center justify-center mb-2">
        <svg class="w-5 h-5 text-church-navy" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z"/>
        </svg>
      </div>
      <div class="font-semibold text-gray-900 text-sm">About Us</div>
      <div class="text-gray-400 text-xs">Who we are</div>
    <% end %>
  </div>
</section>

