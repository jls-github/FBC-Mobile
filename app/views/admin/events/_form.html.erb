<%= render "admin/shared/form_errors", record: event %>
<%= form_with model: [:admin, event], class: "space-y-5" do |f| %>
  <div class="grid md:grid-cols-2 gap-5">
    <div class="md:col-span-2">
      <%= f.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div>
      <%= f.label :starts_at, "Start Date & Time", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.datetime_local_field :starts_at, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div>
      <%= f.label :ends_at, "End Date & Time (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.datetime_local_field :ends_at, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div>
      <%= f.label :location, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :location, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div>
      <%= f.label :category, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :category, Event::CATEGORIES.map { |c| [c.humanize, c] }, {}, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div class="md:col-span-2">
      <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 3, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div>
      <%= f.label :image_url, "Image URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.url_field :image_url, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div>
      <%= f.label :registration_url, "Registration URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.url_field :registration_url, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div class="flex gap-6">
      <label class="flex items-center gap-2">
        <%= f.check_box :featured, class: "w-4 h-4 rounded accent-church-navy" %>
        <span class="text-sm text-gray-700">Featured</span>
      </label>
      <label class="flex items-center gap-2">
        <%= f.check_box :recurring, class: "w-4 h-4 rounded accent-church-navy" %>
        <span class="text-sm text-gray-700">Recurring (weekly)</span>
      </label>
    </div>
  </div>
  <div class="flex gap-3 pt-2">
    <%= f.submit event.new_record? ? "Create Event" : "Save Changes", class: "bg-church-navy text-white font-semibold px-6 py-2.5 rounded-lg text-sm cursor-pointer" %>
    <%= link_to "Cancel", admin_events_path, class: "text-gray-600 text-sm px-4 py-2.5" %>
  </div>
<% end %>
