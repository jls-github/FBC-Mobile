<div class="min-h-screen bg-church-navy flex items-center justify-center px-4">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm p-8">
    <div class="text-center mb-8">
      <div class="w-16 h-16 bg-church-navy rounded-full flex items-center justify-center mx-auto mb-3">
        <svg class="w-8 h-8 text-church-gold" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
      </div>
      <h1 class="text-xl font-bold text-gray-900">FBC Enumclaw Admin</h1>
      <p class="text-gray-500 text-sm mt-1">Sign in to manage your church app</p>
    </div>

    <% if alert = flash[:alert] %>
      <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg mb-5"><%= alert %></div>
    <% end %>

    <%= form_with url: session_url, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            placeholder: "admin@fbcenumclaw.org", value: params[:email_address],
            class: "w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
      </div>
      <div>
        <%= form.label :password, "Password", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password",
            placeholder: "••••••••", maxlength: 72,
            class: "w-full border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
      </div>
      <%= form.submit "Sign In", class: "w-full bg-church-navy text-white font-bold py-3 rounded-xl text-sm cursor-pointer mt-2" %>
    <% end %>
  </div>
</div>
