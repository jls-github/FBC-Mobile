<% content_for :page_title, "Events" %>
<div class="flex justify-between items-center mb-6">
  <p class="text-gray-500 text-sm"><%= @events.count %> total</p>
  <%= link_to "+ New Event", new_admin_event_path, class: "bg-church-navy text-white text-sm font-semibold px-4 py-2 rounded-lg" %>
</div>
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
      <tr>
        <th class="text-left px-4 py-3">Title</th>
        <th class="text-left px-4 py-3 hidden md:table-cell">Date</th>
        <th class="text-left px-4 py-3 hidden md:table-cell">Location</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
      <% @events.each do |event| %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3">
            <div class="font-medium text-gray-900"><%= event.title %></div>
            <span class="text-xs text-gray-400"><%= event.category_label %></span>
          </td>
          <td class="px-4 py-3 text-gray-500 hidden md:table-cell"><%= event.starts_at.strftime("%b %-d, %Y %-I:%M %p") %></td>
          <td class="px-4 py-3 text-gray-500 hidden md:table-cell"><%= event.location %></td>
          <td class="px-4 py-3 text-right">
            <%= link_to "Edit", edit_admin_event_path(event), class: "text-church-navy text-xs font-medium mr-3" %>
            <%= button_to "Delete", admin_event_path(event), method: :delete, data: { confirm: "Delete this event?" }, class: "text-red-500 text-xs font-medium" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
