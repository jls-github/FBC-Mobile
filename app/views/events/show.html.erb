<div class="px-4 pt-4 pb-2">
  <%= link_to events_path, class: "flex items-center gap-1 text-church-navy text-sm font-medium", data: { turbo_action: "advance" } do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/>
    </svg>
    Events
  <% end %>
</div>

<% if @event.image_url.present? %>
  <img src="<%= @event.image_url %>" alt="<%= @event.title %>" class="w-full h-52 object-cover">
<% end %>

<div class="px-4 py-5">
  <div class="flex items-start gap-3">
    <div class="bg-church-navy rounded-xl p-2 text-center min-w-[60px]">
      <div class="text-church-gold text-sm font-bold uppercase"><%= @event.starts_at.strftime("%b") %></div>
      <div class="text-white text-2xl font-bold leading-tight"><%= @event.starts_at.strftime("%-d") %></div>
    </div>
    <div>
      <h1 class="text-xl font-bold text-gray-900 leading-tight"><%= @event.title %></h1>
      <span class="inline-block mt-1 text-xs bg-church-gold/20 text-church-gold font-semibold px-2 py-0.5 rounded-full"><%= @event.category_label %></span>
    </div>
  </div>

  <div class="mt-5 space-y-3">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 bg-church-navy/5 rounded-lg flex items-center justify-center">
        <svg class="w-5 h-5 text-church-navy" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
      <div>
        <div class="text-sm font-medium text-gray-900"><%= @event.formatted_date %></div>
        <div class="text-xs text-gray-500"><%= @event.formatted_time %></div>
      </div>
    </div>

    <% if @event.location.present? %>
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 bg-church-navy/5 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-church-navy" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
          </svg>
        </div>
        <div>
          <div class="text-sm font-medium text-gray-900"><%= @event.location %></div>
          <% if @event.address.present? %>
            <div class="text-xs text-gray-500"><%= @event.address %></div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @event.description.present? %>
    <div class="mt-5">
      <h2 class="font-semibold text-gray-900 mb-2">About This Event</h2>
      <p class="text-gray-600 text-sm leading-relaxed"><%= @event.description %></p>
    </div>
  <% end %>

  <% if @event.registration_url.present? %>
    <a href="<%= @event.registration_url %>" class="mt-5 block w-full text-center bg-church-gold text-church-navy font-bold py-3.5 rounded-2xl text-sm" target="_blank">
      Register Now
    </a>
  <% end %>

  <div class="flex gap-2 mt-3">
    <% if @event.address.present? %>
      <a href="https://maps.apple.com/?q=<%= URI.encode_www_form_component(@event.address) %>" class="flex-1 flex items-center justify-center gap-2 border border-gray-200 rounded-xl py-2.5 text-gray-600 text-sm font-medium">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
        </svg>
        Directions
      </a>
    <% end %>
    <button onclick="navigator.share && navigator.share({title: '<%= j @event.title %>', url: window.location.href})" class="flex-1 flex items-center justify-center gap-2 border border-gray-200 rounded-xl py-2.5 text-gray-600 text-sm font-medium">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z"/>
      </svg>
      Share
    </button>
  </div>
</div>
