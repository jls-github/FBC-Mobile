<%= render "admin/shared/form_errors", record: sermon %>
<%= form_with model: [:admin, sermon], class: "space-y-5" do |f| %>
  <div class="grid md:grid-cols-2 gap-5">
    <div class="md:col-span-2">
      <%= f.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div>
      <%= f.label :speaker, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :speaker, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div>
      <%= f.label :preached_on, "Date Preached", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.date_field :preached_on, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div>
      <%= f.label :scripture_reference, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :scripture_reference, placeholder: "e.g. John 3:16", class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div>
      <%= f.label :sermon_series_id, "Series", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :sermon_series_id, SermonSeries.recent, :id, :name, { include_blank: "— No Series —" }, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div>
      <%= f.label :video_url, "Video URL (YouTube)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.url_field :video_url, placeholder: "https://youtube.com/watch?v=...", class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div>
      <%= f.label :audio_url, "Audio URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.url_field :audio_url, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div>
      <%= f.label :duration_minutes, "Duration (minutes)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :duration_minutes, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div class="md:col-span-2">
      <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 4, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-church-navy" %>
    </div>
    <div>
      <label class="flex items-center gap-2">
        <%= f.check_box :featured, class: "w-4 h-4 rounded accent-church-navy" %>
        <span class="text-sm font-medium text-gray-700">Featured on home screen</span>
      </label>
    </div>
  </div>
  <div class="flex gap-3 pt-2">
    <%= f.submit sermon.new_record? ? "Create Sermon" : "Save Changes", class: "bg-church-navy text-white font-semibold px-6 py-2.5 rounded-lg text-sm cursor-pointer" %>
    <%= link_to "Cancel", admin_sermons_path, class: "text-gray-600 text-sm px-4 py-2.5" %>
  </div>
<% end %>
